# Neon Postgres (브랜치별로 다른 URL 사용 권장)
DATABASE_URL="postgresql://USER:PASS@HOST/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Naver Map (브라우저 SDK)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID="your-public-client-id"

# Naver Geocoding (서버 전용)
NAVER_GEOCODING_CLIENT_ID="your-server-client-id"
NAVER_GEOCODING_CLIENT_SECRET="your-server-secret"

# Kakao Local 키워드 검색 (서버 전용)
KAKAO_REST_API_KEY="your-kakao-rest-api-key"

# /admin Basic Auth
BASIC_AUTH_USER="admin"
BASIC_AUTH_PASS="change-me"

# Sentry (선택)
SENTRY_DSN=""

# 의견 수집 — Google Apps Script Web App webhook URL
# 배포 후 운영자가 발급한 URL을 여기 셋. 빈 값이면 /api/proposals가 503 반환.
PROPOSAL_WEBHOOK_URL=""
